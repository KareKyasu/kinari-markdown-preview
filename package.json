{
	"name": "kinari",
	"displayName": "Kinari — 生成りの紙で読む Markdown",
	"description": "Markdown のプレビューを、生成りの紙のように。七つの和紙の色からお選びいただけます。",
	"publisher": "KareKyasu",
	"version": "1.2.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/KareKyasu/kinari-markdown-preview.git"
	},
	"engines": {
		"vscode": "^1.78.0"
	},
	"main": "./extension.js",
	"activationEvents": [],
	"categories": [
		"Themes"
	],
	"keywords": [
		"markdown",
		"preview",
		"theme",
		"paper",
		"washi",
		"japanese",
		"kinari"
	],
	"contributes": {
		"markdown.previewStyles": [
			"./kinari.css"
		],
		"markdown.markdownItPlugins": true,
		"commands": [
			{
				"command": "kinari.selectPaper",
				"title": "和紙を選ぶ",
				"category": "Kinari",
				"icon": "$(symbol-color)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "kinari.selectPaper",
					"when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor')",
					"group": "navigation@10"
				}
			]
		},
		"configuration": {
			"title": "Kinari",
			"properties": {
				"kinari.paper": {
					"type": "string",
					"enum": [
						"kinari",
						"torinoko",
						"usuzakura",
						"wakana",
						"aijiro",
						"kai",
						"shironeri"
					],
					"default": "kinari",
					"enumDescriptions": [
						"生成り（きなり）・既定 — 晒さぬ木綿の、ほんのり黄みを帯びた白。いつもの一枚",
						"鳥の子（とりのこ） — 鶏の卵の殻を思わせる、淡い玉子色",
						"薄桜（うすざくら） — 春霞にほどける、桜の花びらのごく淡い紅",
						"若菜（わかな） — 雪間に萌え出る若菜の、やさしい黄緑",
						"藍白（あいじろ） — 藍甕にほんのひと浸し。もっとも白に近い藍",
						"海（かい） — 凪の浅瀬に陽の差すような、澄んだ青緑",
						"白練（しろねり） — 練り上げた絹のような、ほのかに温もりのある白"
					],
					"markdownDescription": "プレビューの頁に用いる和紙の色。右上の 🎨 からも、見比べながらお選びいただけます。"
				}
			}
		}
	}
}
